# HaqVaani environment variables
# Copy this file to .env and fill in your Gnani credentials.
# NEVER commit .env — it contains your API key. Synthetic data only.

GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WSS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_SSE_URL=https://api.vachana.ai/tts/v3/stream
GNANI_LLM_URL=http://localhost:8000/v1

# Language codes (Prisma v2.5 / Timbre)
STT_LANG_CODE=hi-IN
TTS_LANG_CODE_CORPORATE=en-IN
TTS_LANG_CODE_CITIZEN=hi-IN

# Sample rates
SAMPLE_RATE=16000
CITIZEN_SAMPLE_RATE=8000
