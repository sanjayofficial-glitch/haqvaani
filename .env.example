# HaqVaani — environment template (copy to .env and fill in your Gnani credentials)
#
# Loading on Windows PowerShell:
#   Copy-Item .env.example .env
#   # then edit .env and for the session run:
#   Get-Content .env | Where-Object { $_ -match '^\s*[^#=]+\s*=' } |
#     ForEach-Object { $k,$v = $_ -split '=',2; $env:$k = $v.Trim() }
# Or export manually:  $env:GNANI_API_KEY = "your-key"
#
# The app is fully functional in offline/demo mode WITHOUT these. Set the key
# (and optionally the URLs) to activate the live Prisma/Evon/Timbre path.

# ------------------------------------------------------------------ credentials
# Your Gnani API key (from https://app.gnani.ai)
GNANI_API_KEY=

# Live endpoint URLs (optional — clients fall back to the documented defaults):
#   STT:  wss://api.vachana.ai/stt/v3/stream
#   TTS:  https://api.vachana.ai/api/v1/tts/sse
#   Evon: hosted vLLM/SGLang URL
GNANI_STT_WSS_URL=
GNANI_TTS_SSE_URL=
GNANI_LLM_URL=

# --------------------------------------------------------------------- STT (Prisma v2.5)
STT_LANG_CODE=hi-IN
STT_FORMAT=transcribe
STT_SAMPLE_RATE=16000
STT_ITN_NATIVE_NUMERALS=false

# VAD presets (telephony-friendly defaults)
STT_VAD_THRESHOLD=0.7
STT_VAD_MIN_SILENCE_MS=500
STT_VAD_MIN_SPEECH_MS=200
STT_VAD_MIN_SEGMENT_MS=120
STT_VAD_IDLE_TIMEOUT_SEC=60

# Word boosting — both must be set to activate (UTRs/amounts/bank names)
STT_BIAS_LIST=
STT_BIAS_SCORE=

# --------------------------------------------------------------------- TTS (Timbre v2.5/v3.0)
TTS_MODEL=timbre-v2.5
TTS_VOICE_HI=Nalini
TTS_VOICE_EN=Kaveri
TTS_VOICE_HINGLISH=Poorvi
TTS_AUDIO_SAMPLE_RATE=48000

# Timbre v3.0 (if TTS_MODEL=timbre-v3.0)
TTS_VOICE_V3=Shivani
